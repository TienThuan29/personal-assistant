{
  "name": "personal-assistant",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "electron-vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "pack": "electron-vite build && electron-builder --config electron-builder.yml --win -c.electronDist=node_modules/electron/dist --publish never",
    "pack:win": "electron-vite build && electron-builder --config electron-builder.yml --win --publish never",
    "pack:mac": "electron-vite build && electron-builder --config electron-builder.yml --mac --publish never",
    "pack:linux": "electron-vite build && electron-builder --config electron-builder.yml --linux --publish never"
  },
  "devDependencies": {
    "@aionui/ui": "file:./vendor/aionui-ui-0.1.0.tgz",
    "@arco-design/color": "0.4.0",
    "@arco-design/web-react": "^2.66.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@icon-park/react": "^1.4.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.1.6",
    "diff2html": "^3.4.55",
    "electron": "37.10.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "i18next": "^26.4.2",
    "json5": "^2.2.3",
    "katex": "^0.16.22",
    "lucide-react": "^1.52.0",
    "mermaid": "^11.13.0",
    "openai": "5.23.2",
    "pdfjs-dist": "^6.4.299",
    "postcss": "^8.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3",
    "unocss": "66.10.5",
    "vite": "^6.4.1",
    "vitest": "^4.0.18",
    "wavedrom": "^3.6.2",
    "zod": "3.25.76"
  }
}
